{
  "name": "jumpstart",
  "version": "0.0.2",
  "description": "A cross-platform Electron wrapper for creative coding projects.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win portable",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:pi": "electron-builder --linux --arm64",
    "build:all": "electron-builder -mwl"
  },
  "author": {
    "name": "Alan Ren",
    "email": "hello@me.alan.ooo",
    "url": "https://alan.ooo"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "devDependencies": {
    "electron": "40.8.0",
    "electron-builder": "26.8.1"
  },
  "build": {
    "appId": "com.electron.jumpstart",
    "productName": "Jumpstart",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "icons/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "darkModeSupport": true,
      "icon": "icons/icon.png",
      "extendInfo": {
        "NSCameraUsageDescription": "Jumpstart needs access to the camera for sites that request it.",
        "NSMicrophoneUsageDescription": "Jumpstart needs access to the microphone for sites that request it."
      }
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icons/icon.png"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
