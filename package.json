{
  "name": "jumpstart",
  "version": "0.0.3",
  "desktopName": "jumpstart.desktop",
  "description": "A cross-platform Electron wrapper for creative coding projects.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux --x64 --arm64",
    "build:pi": "electron-builder --linux deb AppImage --arm64",
    "build:all": "electron-builder -mwl"
  },
  "author": {
    "name": "Alan Ren",
    "email": "hello@me.alan.ooo",
    "url": "https://alan.ooo"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "devDependencies": {
    "electron": "44.9.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.electron.jumpstart",
    "productName": "Jumpstart",
    "afterSign": "scripts/after-sign.js",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "icons/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "darkModeSupport": true,
      "icon": "icons/icon.png",
      "extendInfo": {
        "NSCameraUsageDescription": "Jumpstart needs access to the camera for sites that request it.",
        "NSMicrophoneUsageDescription": "Jumpstart needs access to the microphone for sites that request it."
      }
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icons/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility",
      "syncDesktopName": true,
      "icon": "icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
